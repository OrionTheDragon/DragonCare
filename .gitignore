# Ignore everything by default
/*

# Allow only these specific folders and files in the root
!/Addon 1.20.1/
!/Addon/
!/settings.gradle
!/bump_version.bat
!/bump_version.ps1
!/.gitignore

# Standard ignore patterns for allowed folders
.gradle/
build/
.idea/
*.iml
*.ipr
*.iws
run/
logs/
crash-reports/
*.log

# Ignore scratch scripts and personal logs inside allowed folders
*.py
*.ps1
!/bump_version.ps1
*.jsx
*.txt
!CREDITS.txt
!LICENSE
*.md
!README.md
*.class
